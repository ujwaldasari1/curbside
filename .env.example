# Copy to .env and fill in. .env is gitignored and loaded by the Makefile.

# --- Warehouse (local Postgres inside the OpenMetadata container) ---
CURBSIDE_PG_HOST=localhost
CURBSIDE_PG_PORT=5432
CURBSIDE_PG_DB=curbside
CURBSIDE_ETL_USER=curbside_etl
CURBSIDE_ETL_PASSWORD=curbside_etl

# --- Ingestion ---
# Earliest 311 created_date to backfill (keeps the local DB small).
CURBSIDE_311_START_DATE=2025-01-01
# Optional: a free Socrata app token raises rate limits (https://data.cityofnewyork.us/profile/edit/developer_settings)
SOCRATA_APP_TOKEN=

# --- OpenMetadata (bot JWT from Settings -> Bots -> ingestion-bot) ---
OPENMETADATA_HOST=http://localhost:8585/api
OPENMETADATA_JWT_TOKEN=

# --- Claude (agents) ---
ANTHROPIC_API_KEY=

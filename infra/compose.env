# Consumed by `docker compose --env-file infra/compose.env` (see Makefile).
# Local-only defaults; no secrets live here.

# No Airflow: OpenMetadata ingestion is run by Dagster via the `metadata` CLI.
PIPELINE_SERVICE_CLIENT_ENABLED=false

# Keep the Java heap modest so the whole stack fits in OrbStack's 8 GB cap.
OPENMETADATA_HEAP_OPTS=-Xmx1G -Xms512m
